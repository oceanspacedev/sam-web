APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=900

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

STORAGE_ARCHIVE_ENABLED=false
STORAGE_ARCHIVE_SOURCE_DISK=public
STORAGE_ARCHIVE_TARGET_DISK=s3
STORAGE_ARCHIVE_OLDER_THAN_DAYS=90
STORAGE_ARCHIVE_DELETE_SOURCE=true
STORAGE_ARCHIVE_SCHEDULE_TIME=02:30
STORAGE_ARCHIVE_BATCH_SIZE=500
STORAGE_ARCHIVE_VISIBILITY=private
STORAGE_ARCHIVE_TEMPORARY_URLS=true
# STORAGE_ARCHIVE_DIRECTORIES=profile-photos,imports
STORAGE_ARCHIVE_EXCLUDE=.gitignore,apk/*,livewire-tmp/*

NAS_FTP_HOST=
NAS_FTP_PORT=21
NAS_FTP_USERNAME=
NAS_FTP_PASSWORD=
NAS_FTP_ROOT=/STORAGE-FORM
NAS_FTP_PASSIVE=true
NAS_FTP_SSL=false
NAS_FTP_TIMEOUT=30
NAS_FTP_URL=

VITE_APP_NAME="${APP_NAME}"

ONESIGNAL_APP_ID=

FONNTE_TOKEN=
FONNTE_ENDPOINT=https://api.fonnte.com/send
FONNTE_COUNTRY_CODE=0
FONNTE_TIMEOUT=10
FONNTE_OTP_EXPIRES_IN=60
FONNTE_QUEUE_DELAY_SECONDS=10
# FONNTE_OTP_MESSAGE="Kode OTP SAM Anda: {otp}. Berlaku 1 menit. Jangan bagikan kode ini kepada siapa pun."
# FONNTE_ACCOUNT_REGISTERED_MESSAGE="Halo {name}, nomor WhatsApp Anda sudah terdaftar di SAM dan bisa digunakan untuk login aplikasi. Android: {android_url}. iOS: {ios_url}."

SAM_ANDROID_DOWNLOAD_URL=
SAM_IOS_TESTFLIGHT_URL=

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
