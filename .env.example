APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=sam
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_DOMAIN=null

FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
QUEUE_RETRY_AFTER=900
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

PLAN_VISIT_UPLOAD_CUTOFF_DAY=wednesday
PLAN_VISIT_UPLOAD_CUTOFF_TIME=17:00

IMPORT_SYNC_FALLBACK=true
IMPORT_FORCE_SYNC=false
IMPORT_SUMMARY_TTL_MINUTES=120

ONESIGNAL_APP_ID=

WHATSAPP_GATEWAY_PROVIDER=waha
WHATSAPP_GATEWAY_FALLBACK_PROVIDER=fonnte
WHATSAPP_GATEWAY_FALLBACK_ENABLED=true

WHATSAPP_GATEWAY_WAHA_BASE_URL=http://localhost:3000
WHATSAPP_GATEWAY_WAHA_API_KEY=
WHATSAPP_GATEWAY_WAHA_SESSION=default

WHATSAPP_GATEWAY_FONNTE_ENDPOINT=https://api.fonnte.com/send
WHATSAPP_GATEWAY_FONNTE_TOKEN=

WHATSAPP_GATEWAY_COUNTRY_CODE=62
WHATSAPP_GATEWAY_TIMEOUT=15
WHATSAPP_GATEWAY_MIN_SECONDS_BETWEEN_SENDS=3
WHATSAPP_GATEWAY_MIN_DIGITS=10
WHATSAPP_GATEWAY_MAX_DIGITS=15

WHATSAPP_OTP_EXPIRES_IN=60
WHATSAPP_QUEUE_DELAY_SECONDS=10

SAM_ANDROID_DOWNLOAD_URL=
SAM_IOS_TESTFLIGHT_URL=

OCTANE_SERVER=frankenphp
OCTANE_HTTPS=true
